from typing import Any

from _unsafe import Unsafe


class JsonPickleSerializer:
    def dumps(self, value: Any) -> str | bytes: ...
    def loads(self, payload: str | bytes, *args: Any, **kwargs: Any) -> Unsafe[Any]: ...
    def deserialize(self, payload: str | bytes, *args: Any, **kwargs: Any) -> Unsafe[Any]: ...
    def load(self, payload: str | bytes, *args: Any, **kwargs: Any) -> Unsafe[Any]: ...

